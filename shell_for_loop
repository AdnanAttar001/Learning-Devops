Wait until a file exists

#!/bin/bash

FILE="/tmp/ready.txt"

while [ ! -f "$FILE" ]
do
    echo "Waiting for the file..."
    sleep 2
done

echo "File found!"

-f "$FILE" -> checks whether the file exists and is a regular file.
! means NOT.
sleep 2 waits for two seconds.

